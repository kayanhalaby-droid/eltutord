{
  "name": "elitutor-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for the EliTutor gamified educational web platform.",
  "scripts": {
    "dev": "pnpm --filter api start:dev & pnpm --filter web dev",
    "dev:mock": "pnpm --filter api start:mock & pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:api:mock": "pnpm --filter api start:mock",
    "build": "pnpm --filter \"./packages/**\" build && pnpm --filter \"./apps/**\" build",
    "start": "pnpm --filter \"./apps/**\" start",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.13.0",
    "@typescript-eslint/parser": "7.13.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "husky": "9.0.11",
    "prettier": "3.3.2",
    "typescript": "5.4.5"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["webpack"]
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
